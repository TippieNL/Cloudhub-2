APP_ENV=production
APP_URL=http://localhost:8000
ROOT_DIR=storage/files
READ_ONLY=false
ALLOW_DELETE=true
ALLOW_OVERWRITE=true
# Deleted items move to a trash inside the storage root and are purged after
# TRASH_RETENTION_DAYS. Set TRASH_ENABLED=false to delete permanently instead;
# set the retention to 0 to keep trashed items until someone empties the trash.
TRASH_ENABLED=true
TRASH_RETENTION_DAYS=30
# Storage limits. 0 means unlimited. STORAGE_LIMIT_GB caps the whole file
# store; USER_QUOTA_GB caps what one account may have uploaded. Both are
# checked before an upload starts. Measuring the store walks it, so the
# result is cached for USAGE_CACHE_SECONDS.
STORAGE_LIMIT_GB=0
USER_QUOTA_GB=0
USAGE_CACHE_SECONDS=300
HTTPS_ENABLED=false
REQUIRE_HTTPS=false
TRUST_PROXY=false
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
SESSION_IDLE_SECONDS=3600
SESSION_ABSOLUTE_SECONDS=43200
SESSION_ROTATE_SECONDS=900
SESSION_SAMESITE=Lax
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_RATE_USER_ATTEMPTS=5
LOGIN_RATE_IP_ATTEMPTS=20
LOGIN_RATE_RETENTION_SECONDS=86400
# Generate a long random value for production, e.g. 32+ random bytes encoded as hex.
RATE_LIMIT_SECRET=change-to-a-long-random-secret
SECURITY_EVENT_RETENTION_DAYS=90
SHARE_EXPIRY_HOURS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_file_hub
DB_USER=cloudhub
DB_PASS=change-me
DB_CHARSET=utf8mb4
MAX_UPLOAD_MB=2048
MAX_UPLOAD_FILES=20
UPLOAD_CHUNK_MB=8
UPLOAD_RETRY_COUNT=3
UPLOAD_ABANDON_HOURS=24
UPLOAD_CONFLICT=rename
UPLOAD_STAGING_DIR=

# SMS two-step verification (see SECURITY.md). Off for every account until its
# owner turns it on, and impossible to turn on until SMS_DRIVER is set:
#   twilio   Twilio Programmable Messaging; needs TWILIO_ACCOUNT_SID and
#            TWILIO_AUTH_TOKEN, plus SMS_FROM or TWILIO_MESSAGING_SERVICE_SID
#   webhook  POSTs {"to","from","message"} as JSON to SMS_WEBHOOK_URL, with
#            "Authorization: Bearer SMS_WEBHOOK_TOKEN" when one is set. Plain
#            http:// is accepted only for a gateway on this machine or the LAN.
#   log      development only: writes messages to logs/sms-outbox.log instead
#            of sending them. Refused unless APP_ENV=development.
# Credentials stay in this file, server side; nothing here is ever sent to a
# browser. Never commit real values.
SMS_DRIVER=
# Sender number (E.164, e.g. +15551234567) or an alphanumeric sender ID where
# the destination country allows one.
SMS_FROM=
# Name used in the text of each message.
SMS_APP_NAME=CloudHub
SMS_TIMEOUT_SECONDS=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Key for the HMAC under which codes are stored. Generate 32+ random bytes, e.g.
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Changing it only invalidates codes still waiting to be entered.
TWO_FACTOR_SECRET=
# How long a code works (60-900 s), how many wrong guesses one code survives
# (1-10), and how long before another code may be sent (30-900 s).
TWO_FACTOR_CODE_TTL_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RESEND_SECONDS=60
# Text messages per hour: per account and per phone number, and per client IP.
TWO_FACTOR_SMS_PER_HOUR=5
TWO_FACTOR_SMS_IP_PER_HOUR=20
# Wrong codes (SMS or recovery) per hour before verification is refused for a
# while: per account, and per client IP.
TWO_FACTOR_FAILURES_PER_HOUR=10
TWO_FACTOR_IP_FAILURES_PER_HOUR=30
