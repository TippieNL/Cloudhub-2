<?xml version="1.0" encoding="utf-8"?>
<!-- The camera app needs somewhere to write the photo or clip it just took.
     Scoped to one cache directory so nothing else in app storage is exposed;
     the file is deleted once the upload completes. -->
<paths>
    <cache-path name="captures" path="captures/" />
    <!-- A photo handed from the viewer to another app (Share, Open with,
         Set as): copied here, offered read-only to the app chosen, and
         cleared a day later. See ui/LocalCopies.kt. -->
    <cache-path name="shared" path="shared/" />
</paths>
